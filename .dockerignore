# Python
**/__pycache__/
**/*.py[cod]
**/.venv/
backend/.pytest_cache/
backend/.hypothesis/
.hypothesis/
**/*.egg-info/

# Node
**/node_modules/
frontend/dist/

# VCS / editor / OS
.git/
.gitignore
**/.DS_Store
.claude/

# Docs & infra not needed inside the image
docs/
infra/
*.md

# Local env / secrets -- never bake into the image
.env
**/.env
.env.*
**/.env.*

# CI / compose -- not needed inside the image
docker-compose*.yml
scripts/

# Local diagnostics never enter image build contexts
/diagnostics/
