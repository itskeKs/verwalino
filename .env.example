# Copy to .env and fill in real values. NEVER commit the real .env.
# Used by docker-compose.prod.yml (compose auto-loads .env).

# --- Database passwords (Postgres roles) ---
MIGRATOR_PASSWORD=change-me-strong-migrator-password
APP_RW_PASSWORD=change-me-strong-apprw-password

# --- Session signing secret (use a long random string, >= 32 chars) ---
# e.g.  openssl rand -hex 32
SESSION_SECRET=change-me-long-random-secret

# --- Image to run ---
# Local build: leave as is and use `up -d --build`.
# CI deploy: set to the pushed image, e.g.
#   registry.gitlab.com/<group>/<project>:<tag>
APP_IMAGE=hausverwaltung:local

# --- Networking ---
APP_PORT=8000

# Secure cookie REQUIRES HTTPS (set up a TLS reverse proxy in front of :8000).
# Set to "false" only for a local/plain-HTTP trial, otherwise login cookies are
# dropped by the browser and you cannot stay logged in.
SESSION_COOKIE_SECURE=true

# Uvicorn worker processes.
WEB_CONCURRENCY=2
