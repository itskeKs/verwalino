# Copy this file to .env on the deployment host and set mode 0600. The blank
# passwords and session secret require distinct URL-safe random values
# (`openssl rand -hex 32`); never commit the resulting file.
# Do not commit the resulting .env file.
# Portable first-run setup tokens are printed by self-host.sh start only; never
# add them to this file or .env.selfhost. See DEPLOY.md for browser setup.

# PostgreSQL roles. Rotate the database password first, then this file, then
# the affected service; see DEPLOY.md.
MIGRATOR_PASSWORD=
APP_RW_PASSWORD=
APP_WORKER_PASSWORD=
APP_REVIEW_PASSWORD=

# Signs the HttpOnly __Host-hv_session cookie.
SESSION_SECRET=

# Optional image override. Leave blank for the documented manual host-build:
# deploy-production.sh supplies its immutable local release tag inline.
APP_IMAGE=

# Optional Sentry-compatible errors-only tracking in the API process environment.
# Empty DSN = off (also the self-host default). Never commit a real DSN.
# The portable installer does not accept/forward these optional keys; see DEPLOY.md.
HV_ERROR_TRACKING_DSN=
HV_ERROR_TRACKING_ENVIRONMENT=selfhost
# Error event probability, 0 through 1; no performance tracing.
HV_ERROR_TRACKING_SAMPLE_RATE=1.0

# --- Declaration import / OpenAI Responses ---
# Server-only deployment secret. Intentionally blank; never commit a real key.
# On the host, set it as an unquoted A-Z/a-z/0-9/._- token without an inline comment.
HV_OPENAI_API_KEY=
HV_DECLARATION_QA_ENABLED=false
HV_DECLARATION_QA_MODEL=gpt-5.6-luna
HV_DECLARATION_QA_TIMEOUT_SECONDS=30
HV_DECLARATION_QA_MAX_HITS=20
HV_DECLARATION_QA_MAX_INPUT_TOKENS=20000
HV_DECLARATION_QA_MAX_OUTPUT_TOKENS=1000
HV_DECLARATION_QA_MAX_COST_USD=0.05
HV_DECLARATION_QA_BUDGET_WINDOW_MINUTES=60
HV_DECLARATION_QA_RESERVATION_SECONDS=120
HV_DECLARATION_QA_MAX_CONCURRENCY=4
HV_DECLARATION_QA_INPUT_USD_PER_MILLION=0.20
HV_DECLARATION_QA_OUTPUT_USD_PER_MILLION=1.20
# Deterministic lexical search continues to work when Q&A is disabled.
HV_DECLARATION_SEARCH_TRIGRAM_THRESHOLD=0.25
HV_DATA_REGION=EU
HV_DECLARATION_IMPORT_ENABLED=true
HV_DECLARATION_MAX_PDF_BYTES=26214400
HV_DECLARATION_MAX_DOCUMENTS=10
HV_DECLARATION_MAX_PAGES=500
HV_DECLARATION_OCR_DPI=180
HV_DECLARATION_OCR_TIMEOUT_SECONDS=30
HV_DECLARATION_TEXT_MIN_CHARS=40
HV_DECLARATION_OCR_MAX_PIXELS_PER_PAGE=20000000
HV_DECLARATION_OCR_MAX_TEMP_BYTES=268435456
HV_DECLARATION_OCR_MAX_PAGES_PER_IMPORT=200
HV_DECLARATION_OCR_MAX_PIXELS_PER_IMPORT=400000000
HV_DECLARATION_PREFLIGHT_DEADLINE_SECONDS=600
HV_DECLARATION_PRIMARY_MODEL=gpt-5.6-luna
HV_DECLARATION_ESCALATION_MODEL=gpt-5.4-mini
HV_DECLARATION_PRIMARY_REASONING_EFFORT=medium
HV_DECLARATION_ESCALATION_REASONING_EFFORT=none
HV_DECLARATION_PROMPT_VERSION=declaration-v1
HV_DECLARATION_SCHEMA_VERSION=1
HV_DECLARATION_HARNESS_VERSION=1
HV_DECLARATION_PROVIDER_TIMEOUT_SECONDS=60
HV_DECLARATION_MAX_COST_USD=1.00
HV_DECLARATION_MAX_RECHECK_PAGES=12
HV_DECLARATION_MAX_RECHECK_CALLS=2
HV_DECLARATION_PROVIDER_BATCH_PAGES=20
HV_DECLARATION_PROVIDER_BATCH_CHARS=80000
HV_DECLARATION_MAX_INPUT_TOKENS=500000
HV_DECLARATION_MAX_OUTPUT_TOKENS=60000
HV_DECLARATION_PROVIDER_MAX_OUTPUT_TOKENS_PER_CALL=12000
HV_DECLARATION_MAX_CANDIDATES=5000
# Standard short-context rates (USD / 1M tokens), verified 2026-08-28.
# Reverify when changing model, service tier, processing region, or pricing.
HV_DECLARATION_PRIMARY_INPUT_USD_PER_MILLION=0.20
HV_DECLARATION_PRIMARY_OUTPUT_USD_PER_MILLION=1.20
HV_DECLARATION_PRIMARY_CACHED_INPUT_USD_PER_MILLION=0.02
HV_DECLARATION_PRIMARY_CACHE_WRITE_MULTIPLIER=1.25
HV_DECLARATION_ESCALATION_INPUT_USD_PER_MILLION=0.75
HV_DECLARATION_ESCALATION_OUTPUT_USD_PER_MILLION=4.50
HV_DECLARATION_ESCALATION_CACHED_INPUT_USD_PER_MILLION=0.075
HV_DECLARATION_WORKER_ID=declaration-worker
HV_DECLARATION_WORKER_POLL_SECONDS=2.0
HV_DECLARATION_LEASE_SECONDS=120
HV_DECLARATION_MAX_ATTEMPTS=3

# Runtime tuning; the app is reachable only through the existing Traefik proxy.
WEB_CONCURRENCY=2
FORWARDED_ALLOW_IPS=172.21.0.0/16
