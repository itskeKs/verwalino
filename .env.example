# Environment template for docker-compose.prod.yml. Portable installs use install.sh or
# scripts/self-host.sh init to generate .env.selfhost (0600); do not copy this
# template for that path. Releases ship it as env.example for reference only.
# See DEPLOY.md#install-in-one-command for the release installer and checks.
# For the production Compose stack, copy to .env and set mode 0600. The blank
# passwords and session secret require distinct URL-safe random values
# (`openssl rand -hex 32`); never commit the resulting file.
# Do not commit the resulting .env file.
# Portable self-hosting generates .env.selfhost instead. Backup archives exclude
# that private file; retain it separately for restore (see DEPLOY.md).
# Diagnose portable setup with bash scripts/self-host.sh doctor (see DEPLOY.md).
# Portable first-run setup tokens are printed by self-host.sh start only; never
# add them to this file or .env.selfhost. See DEPLOY.md for browser setup.

# Deployment policy: selfhost (default) or hosted; other values stop startup.
# Pass explicitly to the backend container in custom deployments. The portable
# installer is selfhost-only and does not accept this key in .env.selfhost.
HV_DEPLOYMENT_MODE=selfhost
# Hosted-only signup uses HV_PUBLIC_HOST below and SMTP; pass explicitly in custom deployments.
HV_SMTP_HOST=
HV_SMTP_FROM=
HV_SMTP_PORT=587
HV_SMTP_SECURITY=starttls
HV_SMTP_USERNAME=
HV_SMTP_PASSWORD=

# PostgreSQL roles. Rotate the database password first, then this file, then
# the affected service; see DEPLOY.md.
MIGRATOR_PASSWORD=
APP_RW_PASSWORD=
APP_WORKER_PASSWORD=
APP_REVIEW_PASSWORD=

# Signs the HttpOnly __Host-hv_session cookie.
SESSION_SECRET=

# Public host name of the production stack (Traefik rules, allowed Host header,
# loopback API healthcheck Host header, hosted HTTPS signup links), e.g. verwaltung.example.org. Required; no default.
HV_PUBLIC_HOST=

# Optional image override for the local production Compose stack.
APP_IMAGE=

# Manual support link; API process setting. Portable Compose forwards an exported value.
# Not a .env.selfhost key. No report is automatically sent.
HV_SUPPORT_URL=https://github.com/itskeKs/verwalino/issues

# Optional outbound mail. Portable installs accept these keys in the generated
# private .env.selfhost; omit HOST/FROM to keep mail disabled. The retained
# production Compose stack does not forward them; custom deployments must wire them.
# HOST/FROM and USERNAME/PASSWORD must each be set together or both absent/empty.
# HOST/FROM are trimmed; whitespace-only values are refused.
# Port: 1-65535; security: starttls or tls (never plain); timeout: 1-60 seconds.
# Absent/empty port, security and timeout use the defaults shown below.
# Literal unquoted single-line values; never commit real credentials. See DEPLOY.md.
# No HV_SMTP_* value may contain $ (Compose interpolation); the installer refuses it.
HV_SMTP_HOST=
HV_SMTP_PORT=587
HV_SMTP_FROM=
HV_SMTP_SECURITY=starttls
HV_SMTP_USERNAME=
HV_SMTP_PASSWORD=
HV_SMTP_TIMEOUT_SECONDS=15

# Optional known API image digest (sha256:<64 hex digits>); leave empty when unknown.
HV_IMAGE_DIGEST=

# API process setting: private, transient per-host structural error buffer.
# All web workers in one container must share it; separate containers must not.
# Not a .env.selfhost key; portable Compose uses the container default. See DEPLOY.md.
HV_DIAGNOSTICS_DIR=/tmp/verwalino-diagnostics

# Optional Sentry-compatible errors-only tracking in the API process environment.
# Empty DSN = off (also the self-host default). Never commit a real DSN.
# The portable installer does not accept/forward these optional keys; see DEPLOY.md.
# Release uses HV_RELEASE_ID from the process environment only, else 0.1.0.
# Portable Compose forwards an exported HV_RELEASE_ID; .env.selfhost rejects it.
HV_ERROR_TRACKING_DSN=
HV_ERROR_TRACKING_ENVIRONMENT=selfhost

# Inbox worker: trusted, current ClamAV signatures, readable by container uid 10001.
# Host directory mounted read-only at /var/lib/clamav; update it on the host.
# Compose defaults to ./clamav beside the compose file. Portable: opt-in profile inbox.
HV_CLAMAV_DATABASE_DIR=
# Compose sets HV_WORKER_KIND=workflow_runner, HV_DATABASE_URL_WORKER from
# APP_WORKER_PASSWORD (app_worker), and HV_DOCUMENT_STORAGE_ROOT=/data/documents.
# Inside the worker HV_CLAMAV_DATABASE_DIR=/var/lib/clamav; on a dev host,
# export the host's signature directory before running scripts/dev-local.sh.
# No provider key is used; text PDFs/XML use local extraction, scans need German OCR.

# --- Declaration import / OpenAI Responses ---
# Server-only deployment secret. Intentionally blank; never commit a real key.
# On the host, set it as an unquoted A-Z/a-z/0-9/._- token without an inline comment.
HV_OPENAI_API_KEY=
HV_DECLARATION_QA_ENABLED=false
HV_DECLARATION_QA_MODEL=gpt-5.6-luna
HV_DECLARATION_QA_TIMEOUT_SECONDS=30
HV_DECLARATION_QA_MAX_HITS=20
HV_DECLARATION_QA_MAX_INPUT_TOKENS=20000
HV_DECLARATION_QA_MAX_OUTPUT_TOKENS=1000
HV_DECLARATION_QA_MAX_COST_USD=0.05
HV_DECLARATION_QA_BUDGET_WINDOW_MINUTES=60
HV_DECLARATION_QA_RESERVATION_SECONDS=120
HV_DECLARATION_QA_MAX_CONCURRENCY=4
HV_DECLARATION_QA_INPUT_USD_PER_MILLION=0.20
HV_DECLARATION_QA_OUTPUT_USD_PER_MILLION=1.20
# Deterministic lexical search continues to work when Q&A is disabled.
HV_DECLARATION_SEARCH_TRIGRAM_THRESHOLD=0.25
HV_DATA_REGION=EU
HV_DECLARATION_IMPORT_ENABLED=true
HV_DECLARATION_MAX_PDF_BYTES=26214400
HV_DECLARATION_MAX_DOCUMENTS=10
HV_DECLARATION_MAX_PAGES=500
HV_DECLARATION_OCR_DPI=180
HV_DECLARATION_OCR_TIMEOUT_SECONDS=30
HV_DECLARATION_TEXT_MIN_CHARS=40
HV_DECLARATION_OCR_MAX_PIXELS_PER_PAGE=20000000
HV_DECLARATION_OCR_MAX_TEMP_BYTES=268435456
HV_DECLARATION_OCR_MAX_PAGES_PER_IMPORT=200
HV_DECLARATION_OCR_MAX_PIXELS_PER_IMPORT=400000000
HV_DECLARATION_PREFLIGHT_DEADLINE_SECONDS=600
HV_DECLARATION_PRIMARY_MODEL=gpt-5.6-luna
HV_DECLARATION_ESCALATION_MODEL=gpt-5.4-mini
HV_DECLARATION_PRIMARY_REASONING_EFFORT=medium
HV_DECLARATION_ESCALATION_REASONING_EFFORT=none
HV_DECLARATION_PROMPT_VERSION=declaration-v1
HV_DECLARATION_SCHEMA_VERSION=1
HV_DECLARATION_HARNESS_VERSION=1
HV_DECLARATION_PROVIDER_TIMEOUT_SECONDS=60
HV_DECLARATION_MAX_COST_USD=1.00
HV_DECLARATION_MAX_RECHECK_PAGES=12
HV_DECLARATION_MAX_RECHECK_CALLS=2
HV_DECLARATION_PROVIDER_BATCH_PAGES=20
HV_DECLARATION_PROVIDER_BATCH_CHARS=80000
HV_DECLARATION_MAX_INPUT_TOKENS=500000
HV_DECLARATION_MAX_OUTPUT_TOKENS=60000
HV_DECLARATION_PROVIDER_MAX_OUTPUT_TOKENS_PER_CALL=12000
HV_DECLARATION_MAX_CANDIDATES=5000
# Standard short-context rates (USD / 1M tokens), verified 2026-08-28.
# Reverify when changing model, service tier, processing region, or pricing.
HV_DECLARATION_PRIMARY_INPUT_USD_PER_MILLION=0.20
HV_DECLARATION_PRIMARY_OUTPUT_USD_PER_MILLION=1.20
HV_DECLARATION_PRIMARY_CACHED_INPUT_USD_PER_MILLION=0.02
HV_DECLARATION_PRIMARY_CACHE_WRITE_MULTIPLIER=1.25
HV_DECLARATION_ESCALATION_INPUT_USD_PER_MILLION=0.75
HV_DECLARATION_ESCALATION_OUTPUT_USD_PER_MILLION=4.50
HV_DECLARATION_ESCALATION_CACHED_INPUT_USD_PER_MILLION=0.075
HV_DECLARATION_WORKER_ID=declaration-worker
HV_DECLARATION_WORKER_POLL_SECONDS=2.0
HV_DECLARATION_LEASE_SECONDS=120
HV_DECLARATION_MAX_ATTEMPTS=3

# Hosted website extension only; export in the operator shell, never put this
# key in the strict .env.selfhost installer config. Default rendering uses :main;
# real starts and deploy-server.sh site SHA use a published SHA plus its digest.
# VERWALINO_SITE_IMAGE=ghcr.io/itskeks/verwalino-site:<sha>@sha256:<digest>
# See docs/operations/website-hosting.md. The generic installer stays unchanged.

# Portable self-host backups exclude this file; retain private configuration
# separately. Backup output defaults to the ignored checkout backups/ directory.
# Restore refuses leftover .restore-* document directories; verify live data,
# remove the retained directory, then retry (see DEPLOY.md).

# Runtime tuning; the app is reachable only through the existing Traefik proxy.
WEB_CONCURRENCY=2
# Login IP throttling uses Uvicorn's resolved client address. Trust only the
# actual reverse proxy subnet; never use * for a publicly reachable app.
# The portable installer supplies its own VERWALINO_PROXY_SUBNET for Caddy.
# A direct uvicorn development server should use --no-proxy-headers.
FORWARDED_ALLOW_IPS=172.21.0.0/16
