# Copy this file to .env on the deployment host and set mode 0600. The blank
# passwords and session secret require distinct URL-safe random values
# (`openssl rand -hex 32`); never commit the resulting file.
# Do not commit the resulting .env file.

# PostgreSQL roles. Rotate the database password first, then this file, then
# the affected service; see DEPLOY.md.
MIGRATOR_PASSWORD=
APP_RW_PASSWORD=

# Signs the HttpOnly __Host-hv_session cookie.
SESSION_SECRET=

# Optional image override. Leave blank for the documented manual host-build:
# deploy-production.sh supplies its immutable local release tag inline.
APP_IMAGE=

# Runtime tuning; the app is reachable only through the existing Traefik proxy.
WEB_CONCURRENCY=2
FORWARDED_ALLOW_IPS=172.21.0.0/16
