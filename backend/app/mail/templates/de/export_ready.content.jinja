{% set subject = 'Verwalino: Ihr Datenexport steht bereit' %}
{% set eyebrow = 'DATENEXPORT' %}
{% set heading = 'Ihr Datenexport steht bereit' %}
{% set preheader = 'Das Exportarchiv für Ihre Organisation „' ~ mail.organization_name ~ '“ ist erstellt.' %}
{% set paragraphs = [preheader, 'Der Link öffnet die Exportseite in Verwalino. Melden Sie sich dort als Administrator an, um das Archiv herunterzuladen. Der Link allein gewährt keinen Zugriff.'] %}
