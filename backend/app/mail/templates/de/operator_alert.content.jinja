{% set subject = 'Verwalino: Alarm – ' ~ mail.check ~ ' fehlgeschlagen (' ~ mail.environment ~ ')' %}
{% set eyebrow = 'BETRIEB' %}
{% set heading = 'Eine Betriebsprüfung ist fehlgeschlagen' %}
{% set preheader = 'Die Prüfung „' ~ mail.check ~ '“ ist in der Umgebung „' ~ mail.environment ~ '“ fehlgeschlagen.' %}
{% set paragraphs = [preheader, mail.summary] %}
{% set facts = [('Prüfung', mail.check), ('Umgebung', mail.environment), ('Zeitpunkt', mail.failed_at|berlin_datetime ~ ' Uhr')] %}
{% set links = ([('Prüflauf öffnen', mail.run_url)] if mail.run_url else []) + ([('Issue öffnen', mail.issue_url)] if mail.issue_url else []) %}
{% set why = 'Sie erhalten diese E-Mail, weil diese Adresse automatische Alarme des Verwalino-Betriebs erhält.' %}
