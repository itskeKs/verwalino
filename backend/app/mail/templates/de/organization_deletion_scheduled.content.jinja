{% set subject = 'Verwalino: Löschung Ihrer Organisation am ' ~ mail.effective_on|date_de %}
{% set eyebrow = 'LÖSCHUNG' %}
{% set heading = 'Die Löschung Ihrer Organisation ist vorgemerkt' %}
{% set preheader = 'Ihre Organisation „' ~ mail.organization_name ~ '“ wird am ' ~ mail.effective_on|date_de ~ ' gelöscht.' %}
{% set paragraphs = [preheader, 'Erstellen Sie vorher einen aktuellen Datenexport und speichern Sie ihn sicher.', 'Mit der Löschung endet der Zugang für alle Benutzer Ihrer Organisation. Unterlagen mit gesetzlicher Aufbewahrungspflicht, etwa Buchungsbelege, bleiben für die gesetzliche Frist gesperrt gespeichert und werden danach gelöscht.'] + (['Sie können die Löschung bis zum ' ~ mail.cancel_until|date_de ~ ' in Verwalino zurücknehmen.'] if mail.cancel_until else []) %}
{% set facts = [('Löschung am', mail.effective_on|date_de)] %}
{% set action_label = 'Daten exportieren' %}
{% set action_link = mail.export_link %}
{% set why = 'Sie erhalten diese E-Mail, weil Sie Administrator der zur Löschung vorgemerkten Organisation „' ~ mail.organization_name ~ '“ sind.' %}
