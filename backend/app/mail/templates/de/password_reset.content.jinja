{% set subject = 'Verwalino: Passwort zurücksetzen' %}
{% set eyebrow = 'SICHERHEIT' %}
{% set heading = 'Setzen Sie Ihr Passwort zurück' %}
{% set preheader = 'Sie haben einen Link zum Zurücksetzen Ihres Passworts angefordert.' %}
{% set paragraphs = [preheader, 'Über den folgenden Link können Sie ein neues Passwort festlegen.'] %}
{% set action_label = 'Passwort zurücksetzen' %}
{% set action_link = mail.reset_link %}
{% set duration = '1 Stunde' if mail.valid_minutes == 60 else mail.valid_minutes ~ ' Minuten' %}
{% set notes = ['Der Link ist einmalig gültig und läuft nach ' ~ duration ~ ' ab.', 'Wenn Sie diese Anfrage nicht selbst gestellt haben, ignorieren Sie diese E-Mail.'] %}
{% set why = 'Sie erhalten diese E-Mail, weil für diese Adresse ein neues Passwort angefordert wurde.' %}
