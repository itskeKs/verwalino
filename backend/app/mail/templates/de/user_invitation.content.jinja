{% set subject = 'Verwalino: Einladung von ' ~ mail.organization_name %}
{% set eyebrow = 'KONTO' %}
{% set heading = 'Sie wurden zu Verwalino eingeladen' %}
{% set preheader = mail.inviter_name ~ ' hat Sie zur Organisation „' ~ mail.organization_name ~ '“ eingeladen.' %}
{% set paragraphs = [preheader, 'Legen Sie über den folgenden Link Ihr Passwort fest, um Ihren Zugang einzurichten.'] %}
{% set action_label = 'Passwort festlegen' %}
{% set action_link = mail.set_password_link %}
{% set notes = ['Der Link ist ' ~ mail.valid_hours ~ (' Stunde gültig.' if mail.valid_hours == 1 else ' Stunden gültig.'), 'Wenn Sie diese Einladung nicht erwartet haben, ignorieren Sie diese E-Mail.'] %}
{% set why = 'Sie erhalten diese E-Mail, weil Sie zur Organisation „' ~ mail.organization_name ~ '“ in Verwalino eingeladen wurden.' %}
