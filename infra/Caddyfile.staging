# Import into the hosted Caddyfile; mount alongside it. One Caddy owns TLS.
staging.verwalino.de {
    request_body {
        max_size 30MB
    }
    header {
        X-Robots-Tag "noindex, nofollow"
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        -Server
    }
    handle /robots.txt {
        respond <<ROBOTS
            User-agent: *
            Disallow: /
            ROBOTS 200
    }
    handle {
        reverse_proxy staging-app:8000
    }
}
