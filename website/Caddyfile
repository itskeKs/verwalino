{
    admin off
    auto_https off
    persist_config off
}

:8080 {
    root * /usr/share/caddy
    encode zstd gzip
    file_server
    handle_errors {
        @english path /en /en/*
        handle @english {
            rewrite * /en/404/index.html
            file_server
        }
        handle {
            rewrite * /404.html
            file_server
        }
    }
}
