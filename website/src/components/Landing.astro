<div>
<h3>{text("s.r7.t")}</h3>
<p>{text("s.r7.p")}</p>
</div>
</div>
<div class="money-row">
<div class="row-tag">
<span>{text("s.r8.t")}</span> · XML</div>
<div>
<h3>{text("s.r8.t")}</h3>
<p>{text("s.r8.p")}</p>
</div>
</div>
