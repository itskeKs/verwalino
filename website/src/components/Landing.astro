<div class="bank-flow">
<div class="flow-intro">
<div>
<p class="eyebrow">{text("flow.eyebrow")}</p>
<h3>{text("s.diag.h")}</h3>
</div>
<p>{text("s.diag.p")}</p>
</div>
<div class="diagram">
<div class="flow-stage">
<div class="flow-head">
<span>{text("s.diag.a")}</span>
<span>CAMT.053 · XML</span>
</div>
<div class="code-scroll" tabindex="0" role="region" aria-label={text("visual.codescroll")} >
<pre class="flow-code">
<code>&lt;Ntry&gt;
 &lt;Amt Ccy="EUR"&gt;<span class="highlight">780.00</span>&lt;/Amt&gt;
 &lt;BookgDt&gt;2026-03-03&lt;/BookgDt&gt;
 &lt;Ustrd&gt;<span>{text("flow.reference")}</span>
 <span class="highlight">Lindenallee 12</span>&lt;/Ustrd&gt;
&lt;/Ntry&gt;</code>
</pre>
</div>
</div>
<div class="flow-arrow" aria-hidden="true">→</div>
<div class="flow-stage">
<div class="flow-head">
<span>{text("s.diag.b")}</span>
</div>
<dl class="flow-kv">
<div>
<dt>{text("s.diag.b1")}</dt>
<dd>{text("s.diag.b1v")}</dd>
</div>
<div>
<dt>{text("s.diag.b2")}</dt>
<dd>
<span class="highlight amount">780,00 €</span> = <span>{text("flow.due")}</span>
</dd>
</div>
<div>
<dt>{text("s.diag.b3")}</dt>
<dd>
<span class="highlight">Lindenallee 12</span>
</dd>
</div>
<div class="result">
<dt>{text("s.diag.b4")}</dt>
<dd>{text("flow.unit")}</dd>
</div>
</dl>
</div>
<div class="flow-arrow" aria-hidden="true">→</div>
<div class="flow-stage flow-account">
<div class="flow-head">
<span>{text("s.diag.c")}</span>
<span>Lindenallee 12</span>
</div>
<div class="table-scroll" tabindex="0" role="region" aria-label={text("visual.scroll")} >
