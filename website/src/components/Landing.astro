---
import { t, type Locale } from "../i18n";
import { pathFor } from "../content/routes";
import Rich from "./Rich.astro";
interface Props { locale: Locale }
const { locale } = Astro.props;
const text = t(locale);
---

<section id="hero" class="band hero" aria-labelledby="hero-title">
<div class="wrap">
<div class="hero-layout">
<div class="hero-text">
<p class="eyebrow">{text("hero.eyebrow")}</p>
<h1 id="hero-title">
<span class="headline-line">
<span class="headline-word" style="--i:0">{text("hero.1")}</span>
</span>
<span class="headline-line">
<span class="headline-word" style="--i:1">{text("hero.2")}</span>
</span>
<span class="headline-line">
<span class="headline-word" style="--i:2">{text("hero.3")}</span>
</span>
</h1>
<p class="hero-copy">{text("k.sub")}</p>
<div class="ctas ">
<a class="button primary" href={pathFor(locale, "signup")}>
<span>{text("cta.start")}</span>
<small>
<span>{text("soon")}</span>
</small>
<svg viewBox="0 0 24 24" aria-hidden="true">
<path d="M4 12h15M13 6l6 6-6 6"/>
</svg>
</a>
<a class="button secondary" href={pathFor(locale, "selfhost")}>
<span>{text("cta.self")}</span>
